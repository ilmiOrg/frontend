# Template for local development. Copy to `.env` and adjust:
#   cp .env.default .env
# `.env` is gitignored — never commit real secrets.

# Backend API (embedded in the client build; see src/api/config.js)
REACT_APP_API_URL=http://localhost:8080

# Dev server (react-scripts / package.json start script may also set PORT)
PORT=3002

FAST_REFRESH=true
CHOKIDAR_USEPOLLING=true
